# Traffic and energy data
traffic_data = [3, 4, 5, 6, 4, 3, 7, 5]
energy_data = [20, 21, 23, 25, 28, 30, 32, 35]

# Pollution from traffic
pollution = 0
pollution_over_time = []

for t in traffic_data:
    pollution += t
    pollution_over_time.append(pollution)

# Statistics function (average, min, max)
def stats(values):
    avg = sum(values) / len(values)
    minimum = min(values)
    maximum = max(values)
    return avg, minimum, maximum

traffic_avg, traffic_min, traffic_max = stats(traffic_data)
energy_avg, energy_min, energy_max = stats(energy_data)
pollution_avg, pollution_min, pollution_max = stats(pollution_over_time)

# Print results
print("=== TRAFFIC DATA ===")
print("Traffic list:", traffic_data)
print("Average:", traffic_avg)
print("Min:", traffic_min)
print("Max:", traffic_max)
print()

